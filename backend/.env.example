# Bu dosyayı `.env` adıyla kopyala ve değeri kendi hesabından doldur.
# `.env` git'e girmez; gerçek değerleri bu dosyaya yazma.

# Neon (veya başka bir PostgreSQL) bağlantı adresi.
# Neon panelinde: Connect > Connection string. Sonunda `?sslmode=verify-full` olmalı
# (`require` da çalışır ama `pg` uyarı basar).
DATABASE_URL=

# Yalnızca Postgres testleri için (isteğe bağlı). Neon'da ayrı bir branch aç ve onun
# DOĞRUDAN (pooled olmayan) bağlantı adresini yaz. Boşsa Postgres testleri atlanır.
TEST_DATABASE_URL=

# Google ile giriş için OAuth istemci kimliği.
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web).
# Boşsa Google ile giriş kapalıdır. Yetkili JavaScript kaynağı olarak
# `http://localhost:3000` ve canlı adresi ekle.
GOOGLE_CLIENT_ID=

# Doğal dille randevu asistanı ve seans öncesi e-posta özeti için Google Gemini API anahtarı.
# Google AI Studio (https://aistudio.google.com/apikey) üzerinden alınır.
# Boşsa yerel kural tabanlı Türkçe ayrıştırıcı ve özetleyici devreye girer.
GEMINI_API_KEY=

# Kullanılacak Gemini modeli (varsayılan: gemini-2.5-flash).
GEMINI_MODEL=gemini-2.5-flash
