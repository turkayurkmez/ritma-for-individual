# Bu dosyayı `.env` adıyla kopyala ve değeri kendi hesabından doldur.
# `.env` git'e girmez; gerçek değerleri bu dosyaya yazma.

# Neon (veya başka bir PostgreSQL) bağlantı adresi.
# Neon panelinde: Connect > Connection string. Sonunda `?sslmode=verify-full` olmalı
# (`require` da çalışır ama `pg` uyarı basar).
DATABASE_URL=

# Yalnızca Postgres testleri için (isteğe bağlı). Neon'da ayrı bir branch aç ve onun
# DOĞRUDAN (pooled olmayan) bağlantı adresini yaz. Boşsa Postgres testleri atlanır.
TEST_DATABASE_URL=
