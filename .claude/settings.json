{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "Read(**/.env.production)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.test)",
      "Edit(**/.env.production)",
      "Bash(cat *.env)",
      "Bash(type *.env)",
      "Bash(Get-Content *.env)"
    ]
  }
}
